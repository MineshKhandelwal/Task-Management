{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--experimental-require-module\" vitest run",
    "test:watch": "NODE_OPTIONS=\"--experimental-require-module\" vitest",
    "test:coverage": "NODE_OPTIONS=\"--experimental-require-module\" vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@reduxjs/toolkit": "^2.15.0",
    "mongoose": "^8.24.10",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-redux": "^9.3.1",
    "sass": "^1.99.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^0.5.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.0.1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^3.100.0"
  }
}
